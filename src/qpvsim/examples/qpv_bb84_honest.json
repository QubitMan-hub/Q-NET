          }
        }
      ],
      "transitions": [
        {
          "id": "arm",
          "from": "idle",
          "to": "armed",
          "trigger": {
            "type": "start"
          },
          "label": "schedule challenge",
          "duration_ns": 0,
          "actions": [
            {
              "op": "set",
