{
  "format": "qpvsim-project",
  "version": 1,
  "meta": {
    "name": "QPV_BB84 \u2014 honest prover",
    "description": "Two verifiers on a line challenge a prover claiming position x = 0. The prover is honest and located at the claimed position.",
    "protocol": {
      "name": "QPV_BB84",
      "version": "1.0",
      "references": [
        "A. Kent, W. J. Munro, T. P. Spiller, 'Quantum tagging: authenticating location via quantum information and relativistic signalling constraints', Phys. Rev. A 84, 012326 (2011); arXiv:1008.2147",
        "H.-K. Lau, H.-K. Lo, 'Insecurity of position-based quantum-cryptography protocols against entanglement attacks', Phys. Rev. A 83, 012322 (2011); arXiv:1009.2256",
        "H. Buhrman, N. Chandran, S. Fehr, R. Gelles, V. Goyal, R. Ostrovsky, C. Schaffner, 'Position-based quantum cryptography: impossibility and constructions', SIAM J. Comput. 43(1) (2014); arXiv:1009.2490",
        "M. Tomamichel, S. Fehr, J. Kaniewski, S. Wehner, 'A monogamy-of-entanglement game with applications to device-independent quantum cryptography', New J. Phys. 15, 103002 (2013); arXiv:1210.4359"
      ]
    },
    "assumptions": [
      "One spatial dimension in effect: all participants lie on the x axis; signals travel on straight lines at the configured speed (default: vacuum speed of light).",
      "Verifiers are trusted, know their own positions and the claimed position exactly, share private randomness (x, theta) established before t=0, and have synchronised clocks unless clock offsets/drift are configured.",
      "Verifiers decide offline after the round; the final decision combines both verdicts with the rule 'all must accept'.",
      "One simulation run = one protocol round; acceptance probabilities are estimated over many independent runs (experiments)."
    ],
    "limitations": [
      "Simulation results are evidence about the modelled behaviour only; they are not security proofs.",
      "No special/general-relativistic effects beyond a finite signal speed; no clock-synchronisation protocol is modelled (offsets/drift are fixed parameters).",
      "Qubit loss makes QPV_BB84 attackable by provers who may claim loss; this model treats a missing answer as a rejection and does not model loss-tolerant variants.",
      "Adversary strategies are the specific automata supplied; the simulator does not search over all strategies, so observed success rates are lower bounds on what attackers can achieve."
    ]
  },
  "physics": {
    "signal_speed_mps": 299792458,
    "allow_superluminal": false
  },
  "simulation": {
    "seed": 7,
    "backend": "density_matrix",
    "max_time_ns": 1000,
    "max_events": 100000,
    "stop_when": "verifiers_decided",
    "priorities": {}
  },
  "claim": {
    "prover": "P",
    "position": [
      0.0,
      0.0
    ]
  },
  "participants": [
    {
      "id": "V0",
      "role": "verifier",
      "label": "Verifier V0 (qubit)",
      "position": [
        -3.0,
        0.0
      ],
      "automaton": "qpv_bb84_verifier_quantum",
      "params": {
        "t_ref_ns": 20.0,
        "tolerance_ns": 0.5
      },
      "processing_ns": 0.0,
      "start_ns": 0,
      "clock": {
        "offset_ns": 0,
        "drift_ppm": 0
      },
      "capabilities": "verifier",
      "noise": {},
      "group": null,
      "ui": {
        "x": 40,
        "y": 220
      }
    },
    {
      "id": "V1",
      "role": "verifier",
      "label": "Verifier V1 (basis)",
      "position": [
        3.0,
        0.0
      ],
      "automaton": "qpv_bb84_verifier_classical",
      "params": {
        "t_ref_ns": 20.0,
        "tolerance_ns": 0.5
      },
      "processing_ns": 0.0,
      "start_ns": 0,
      "clock": {
        "offset_ns": 0,
        "drift_ppm": 0
      },
      "capabilities": "verifier",
      "noise": {},
      "group": null,
      "ui": {
        "x": 1120,
        "y": 220
      }
    },
    {
      "id": "P",
      "role": "prover",
      "label": "Prover P",
      "position": [
        0.0,
        0.0
      ],
      "automaton": "qpv_bb84_honest_prover",
      "params": {},
      "processing_ns": 0.2,
      "start_ns": 0,
      "clock": {
        "offset_ns": 0,
        "drift_ppm": 0
      },
      "capabilities": "honest_prover",
      "noise": {},
      "group": null,
      "ui": {
        "x": 580,
        "y": 220
      }
    }
  ],
  "links": [
    {
      "id": "q0",
      "kind": "quantum",
      "a": {
        "node": "V0",
        "port": "prover"
      },
      "b": {
        "node": "P",
        "port": "left"
      },
      "directed": false,
      "length_m": null,
