    "qpv_bb84_honest_prover": {
      "name": "qpv_bb84_honest_prover",
      "role": "prover",
      "description": "Honest QPV_BB84 prover: waits for both the qubit and theta, measures the qubit in basis theta and broadcasts the outcome to both verifiers.",
      "ports": [
        "left",
        "right"
      ],
      "params": {},
      "variables": {
        "answer": 0
      },
      "initial": "waiting",
      "states": [
        {
          "id": "waiting",
          "kind": "initial",
          "label": "Await challenges",
          "ui": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "done",
          "kind": "terminal",
          "outcome": "done",
          "label": "Answered",
          "ui": {
            "x": 0,
            "y": 160
          }
        }
      ],
      "transitions": [
        {
          "id": "respond",
          "from": "waiting",
          "to": "done",
          "trigger": {
            "type": "receive",
            "tags": [
              "q",
              "theta"
            ]
          },
          "label": "measure & answer",
          "actions": [
            {
              "op": "measure",
              "qubit": "q",
              "basis": "msgs.theta.value",
              "result": "answer"
            },
            {
              "op": "send",
              "port": "left",
              "tag": "answer",
              "value": "answer"
            },
            {
              "op": "send",
              "port": "right",
              "tag": "answer",
              "value": "answer"
            }
          ]
        }
      ]
    }
  },
  "verification": {
    "rule": "all",
    "verifiers": [
      "V0",
      "V1"
    ]
  },
  "experiments": [
    {
      "id": "noise_sweep",
      "name": "Acceptance vs. channel depolarisation",
      "runs": 400,
      "seed": 11,
      "sweep": [
        {
          "path": "links.q0.noise.depolarizing",
          "values": [
            0.0,
            0.05,
            0.1,
            0.2,
            0.4
          ]
        }
      ]
    },
    {
      "id": "processing_sweep",
      "name": "Acceptance vs. prover processing time",
      "runs": 50,
      "seed": 12,
      "sweep": [
        {
          "path": "participants.P.processing_ns",
          "values": [
            0.0,
            0.25,
            0.5,
            0.75,
            1.0
          ]
        }
      ]
    }
  ]
}
