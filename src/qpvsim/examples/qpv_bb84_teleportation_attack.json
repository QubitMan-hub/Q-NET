    "qpv_adv_chain0_2v": {
      "name": "qpv_adv_chain0_2v",
      "role": "adversary",
      "description": "Teleportation-chain attacker 0 of 1: teleports the intercepted qubit into the chain; after one round of broadcast it decodes x from the Pauli frame and answers its verifier.",
      "ports": [
        "verifier",
        "p1"
      ],
      "params": {},
      "variables": {
        "s": 0,
        "b0": 0,
        "b1": 0,
        "m": 0,
        "fx": 0,
        "fz": 0,
        "t": 0
      },
      "initial": "intercept",
      "states": [
        {
          "id": "intercept",
          "kind": "initial",
          "label": "Intercept challenge",
          "ui": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "relayed",
          "kind": "normal",
          "label": "Await partners",
          "ui": {
            "x": 0,
            "y": 130
          }
        },
        {
          "id": "done",
          "kind": "terminal",
          "label": "Answered",
          "ui": {
            "x": 0,
            "y": 260
          },
          "outcome": "done"
        }
      ],
      "transitions": [
        {
          "id": "teleport",
          "from": "intercept",
          "to": "relayed",
          "label": "teleport",
          "trigger": {
            "type": "receive",
            "tags": [
              "q"
            ],
            "port": "verifier"
          },
          "actions": [
            {
              "op": "bell_measure",
              "qubits": [
                "q",
                "out"
              ],
              "results": [
                "b0",
                "b1"
              ]
            },
            {
              "op": "send",
              "port": "p1",
              "tag": "e0",
              "value": "[b0, b1]"
            }
          ]
        },
        {
          "id": "decode",
          "from": "relayed",
          "to": "done",
          "label": "decode & answer",
          "trigger": {
            "type": "receive",
            "tags": [
              "e1"
            ]
          },
          "actions": [
            {
              "op": "set",
              "var": "fx",
              "expr": "0"
            },
            {
              "op": "set",
              "var": "fz",
              "expr": "0"
            },
            {
              "op": "set",
              "var": "fx",
              "expr": "fx ^ b1"
            },
            {
              "op": "set",
              "var": "fz",
              "expr": "fz ^ b0"
            },
            {
              "op": "set",
              "var": "t",
              "expr": "fx"
            },
            {
              "op": "set",
              "var": "fx",
              "expr": "fz if msgs.e1.value[0] else fx"
            },
            {
              "op": "set",
              "var": "fz",
              "expr": "t if msgs.e1.value[0] else fz"
            },
            {
              "op": "send",
              "port": "verifier",
              "tag": "answer",
              "value": "msgs.e1.value[1] ^ fx"
            }
          ]
        }
      ]
    },
