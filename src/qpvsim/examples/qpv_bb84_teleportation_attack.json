  "automata": {
    "qpv_bb84_verifier_quantum": {
      "name": "qpv_bb84_verifier_quantum",
      "role": "verifier",
      "description": "QPV_BB84 verifier that sends the BB84 qubit H^theta|x>. Accepts iff the answer equals x and arrives by the deadline t_ref + d(V, claim)/c + tolerance (local clock).",
      "ports": [
        "prover"
      ],
      "params": {
        "t_ref_ns": {
          "default": 20.0,
          "description": "Agreed time at which both challenges reach the claimed position."
        },
        "tolerance_ns": {
          "default": 0.5,
          "description": "Allowed processing time of the prover (deadline slack)."
        }
      },
      "variables": {
        "x": 0,
        "theta": 0,
        "send_at": 0.0,
        "deadline": 0.0,
        "sent_at": 0.0
      },
      "initial": "idle",
      "states": [
        {
          "id": "idle",
          "kind": "initial",
          "label": "Idle",
          "ui": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "armed",
          "kind": "normal",
          "label": "Armed",
          "ui": {
            "x": 0,
            "y": 140
          },
          "description": "Waiting for the emission instant."
        },
        {
          "id": "waiting",
          "kind": "normal",
          "label": "Awaiting answer",
          "ui": {
            "x": 0,
            "y": 290
          }
        },
        {
          "id": "accepted",
          "kind": "terminal",
          "outcome": "accept",
          "label": "Accept",
          "ui": {
            "x": -300,
            "y": 470
          }
        },
        {
          "id": "rejected",
          "kind": "terminal",
          "outcome": "reject",
          "label": "Reject",
          "ui": {
            "x": 300,
            "y": 470
          }
        }
      ],
      "transitions": [
        {
          "id": "arm",
          "from": "idle",
          "to": "armed",
          "trigger": {
            "type": "start"
          },
          "label": "schedule challenge",
          "duration_ns": 0,
          "actions": [
            {
              "op": "set",
              "var": "send_at",
              "expr": "fs_round(t_ref_ns - claim_travel_ns)"
            },
            {
              "op": "set",
              "var": "deadline",
              "expr": "fs_round(t_ref_ns + claim_travel_ns + tolerance_ns)"
            },
            {
              "op": "timer",
              "name": "emit",
              "at_ns": "send_at"
            }
          ]
        },
        {
          "id": "emit",
          "from": "armed",
          "to": "waiting",
          "trigger": {
            "type": "timer",
            "name": "emit"
          },
          "label": "send challenge",
          "duration_ns": 0,
          "actions": [
            {
              "op": "prepare_bb84",
              "qubit": "q",
              "bit": "x",
              "basis": "theta"
            },
            {
              "op": "send_qubit",
              "port": "prover",
              "tag": "q",
              "qubit": "q"
            },
            {
              "op": "set",
              "var": "sent_at",
              "expr": "now"
            },
            {
              "op": "record",
              "key": "challenge_sent_ns",
              "value": "now"
            },
            {
              "op": "record",
              "key": "deadline_ns",
              "value": "deadline"
            },
            {
              "op": "timer",
              "name": "deadline",
              "at_ns": "deadline"
            }
          ]
        },
        {
          "id": "accept",
          "from": "waiting",
          "to": "accepted",
          "trigger": {
            "type": "receive",
            "tags": [
              "answer"
            ],
            "port": "prover"
          },
          "guard": "msg.value == x and msg.time <= deadline",
          "label": "correct & on time",
          "duration_ns": 0,
          "actions": [
            {
              "op": "cancel_timer",
              "name": "deadline"
            },
            {
              "op": "record",
              "key": "response_ns",
              "value": "msg.time"
            },
            {
              "op": "record",
              "key": "rtt_ns",
              "value": "msg.time - sent_at"
            },
            {
              "op": "verdict",
              "outcome": "accept",
              "reason": "'correct answer ' + str(msg.value) + ' received at ' + str(round(msg.time, 6)) + ' ns <= deadline ' + str(round(deadline, 6)) + ' ns'"
            }
          ]
        },
        {
          "id": "wrong",
          "from": "waiting",
          "to": "rejected",
          "trigger": {
            "type": "receive",
            "tags": [
              "answer"
            ],
            "port": "prover"
          },
          "label": "wrong answer",
          "duration_ns": 0,
          "actions": [
            {
              "op": "cancel_timer",
              "name": "deadline"
            },
            {
              "op": "record",
              "key": "response_ns",
              "value": "msg.time"
            },
            {
              "op": "record",
              "key": "rtt_ns",
              "value": "msg.time - sent_at"
            },
            {
              "op": "verdict",
              "outcome": "reject",
              "reason": "'wrong answer ' + str(msg.value) + ' (expected ' + str(x) + ')'"
            }
          ]
        },
        {
          "id": "timeout",
          "from": "waiting",
          "to": "rejected",
          "trigger": {
            "type": "timer",
            "name": "deadline"
          },
          "label": "deadline passed",
          "duration_ns": 0,
          "actions": [
            {
              "op": "verdict",
              "outcome": "reject",
              "reason": "'no answer by the deadline ' + str(round(deadline, 6)) + ' ns'"
            }
          ]
        }
      ]
    },
