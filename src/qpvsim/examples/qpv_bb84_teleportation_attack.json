    "qpv_bb84_adv_teleport_sender": {
      "name": "qpv_bb84_adv_teleport_sender",
      "role": "adversary",
      "description": "Teleportation attack, adversary near the qubit-sending verifier: Bell-measures the intercepted qubit with its EPR half 'e' (teleporting it to the partner), sends both outcomes, and corrects the partner's result once (theta, m) arrives. x = m XOR (b1 if theta == 0 else b0).",
      "ports": [
        "verifier",
        "partner"
      ],
      "params": {},
      "variables": {
        "b0": 0,
        "b1": 0
      },
      "initial": "intercept",
      "states": [
        {
          "id": "intercept",
          "kind": "initial",
          "label": "Intercept qubit",
          "ui": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "teleported",
          "kind": "normal",
          "label": "Await (theta, m)",
          "ui": {
            "x": 0,
            "y": 130
          }
        },
        {
          "id": "done",
          "kind": "terminal",
          "outcome": "done",
          "label": "Answered",
          "ui": {
            "x": 0,
            "y": 260
          }
        }
      ],
      "transitions": [
        {
          "id": "teleport",
          "from": "intercept",
          "to": "teleported",
          "trigger": {
            "type": "receive",
            "tags": [
              "q"
            ],
            "port": "verifier"
          },
          "label": "Bell measurement",
          "actions": [
            {
              "op": "bell_measure",
              "qubits": [
                "q",
                "e"
              ],
              "results": [
                "b0",
                "b1"
              ]
            },
            {
              "op": "send",
              "port": "partner",
              "tag": "corr",
              "value": "[b0, b1]"
            }
          ]
        },
        {
          "id": "answer",
          "from": "teleported",
          "to": "done",
          "trigger": {
            "type": "receive",
            "tags": [
              "tm"
            ],
            "port": "partner"
          },
          "label": "correct & answer",
          "actions": [
            {
              "op": "send",
              "port": "verifier",
              "tag": "answer",
              "value": "msg.value[1] ^ (b1 if msg.value[0] == 0 else b0)"
            }
          ]
        }
      ]
    },
