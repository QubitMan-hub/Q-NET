  "automata": {
    "qpv_verifier_quantum": {
      "name": "qpv_verifier_quantum",
      "role": "verifier",
      "description": "Quantum verifier: sends the BB84 qubit H^b|x>, with b = combine(shares). Times its signal to reach the claimed position at t_ref and accepts iff the answer equals x and arrives by t_ref + d(V, claim)/c + tolerance (local clock, integer fs).",
      "ports": [
        "prover"
      ],
      "params": {
        "t_ref_ns": {
          "default": 20.0,
          "description": "Agreed time at which all challenges reach the claimed position."
        },
        "tolerance_ns": {
          "default": 0.5,
          "description": "Allowed processing time of the prover (deadline slack)."
        },
        "combine": {
          "default": "xor",
          "description": "How the classical shares form the basis: xor | inner_product."
        }
      },
      "variables": {
        "x": 0,
        "shares": [
          0
        ],
        "deadline_fs": 0,
        "sent_at": 0.0
      },
      "initial": "idle",
      "states": [
        {
          "id": "idle",
          "kind": "initial",
          "label": "Idle",
          "ui": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "armed",
          "kind": "normal",
          "label": "Armed",
          "ui": {
            "x": 0,
            "y": 140
          }
        },
        {
          "id": "waiting",
          "kind": "normal",
          "label": "Awaiting answer",
          "ui": {
            "x": 0,
            "y": 290
          }
        },
        {
          "id": "accepted",
          "kind": "terminal",
          "label": "Accept",
          "ui": {
            "x": -300,
            "y": 470
          },
          "outcome": "accept"
        },
        {
          "id": "rejected",
          "kind": "terminal",
          "label": "Reject",
          "ui": {
            "x": 300,
            "y": 470
          },
          "outcome": "reject"
        }
      ],
      "transitions": [
        {
          "id": "arm",
          "from": "idle",
          "to": "armed",
          "trigger": {
            "type": "start"
          },
          "label": "schedule challenge",
          "duration_ns": 0,
          "actions": [
            {
              "op": "set",
              "var": "deadline_fs",
              "expr": "fs(t_ref_ns) + claim_travel_fs + fs(tolerance_ns)"
            },
            {
              "op": "timer",
              "name": "emit",
              "at_fs": "fs(t_ref_ns) - claim_travel_fs"
            }
          ]
        },
        {
          "id": "emit",
          "from": "armed",
          "to": "waiting",
          "trigger": {
            "type": "timer",
            "name": "emit"
          },
          "label": "send challenge",
          "duration_ns": 0,
          "actions": [
            {
              "op": "prepare_bb84",
              "qubit": "q",
              "bit": "x",
              "basis": "combine(combine, shares)"
            },
            {
              "op": "send_qubit",
              "port": "prover",
              "tag": "q",
              "qubit": "q"
            },
            {
              "op": "set",
              "var": "sent_at",
              "expr": "now"
            },
            {
              "op": "record",
              "key": "challenge_sent_ns",
              "value": "now"
            },
            {
              "op": "record",
              "key": "deadline_ns",
              "value": "deadline_fs / 1e6"
            },
            {
              "op": "timer",
              "name": "deadline",
              "at_fs": "deadline_fs"
            }
          ]
        },
        {
          "id": "accept",
          "from": "waiting",
          "to": "accepted",
          "trigger": {
            "type": "receive",
            "tags": [
              "answer"
            ],
            "port": "prover"
          },
          "guard": "msg.value == x and msg.time_fs <= deadline_fs",
          "label": "correct & on time",
          "duration_ns": 0,
          "actions": [
            {
              "op": "cancel_timer",
              "name": "deadline"
            },
            {
              "op": "record",
              "key": "response_ns",
              "value": "msg.time"
            },
            {
              "op": "record",
              "key": "rtt_ns",
              "value": "msg.time - sent_at"
            },
            {
              "op": "verdict",
              "outcome": "accept",
              "reason": "'correct answer ' + str(msg.value) + ' received at ' + str(round(msg.time, 6)) + ' ns <= deadline ' + str(round(deadline_fs / 1e6, 6)) + ' ns'"
            }
          ]
        },
        {
          "id": "wrong",
          "from": "waiting",
          "to": "rejected",
          "trigger": {
            "type": "receive",
            "tags": [
              "answer"
            ],
            "port": "prover"
          },
          "label": "wrong answer",
          "duration_ns": 0,
          "actions": [
            {
              "op": "cancel_timer",
              "name": "deadline"
            },
            {
              "op": "record",
              "key": "response_ns",
              "value": "msg.time"
            },
            {
              "op": "record",
              "key": "rtt_ns",
              "value": "msg.time - sent_at"
            },
            {
              "op": "verdict",
              "outcome": "reject",
              "reason": "'wrong answer ' + str(msg.value) + ' (expected ' + str(x) + ')'"
            }
          ]
        },
        {
          "id": "timeout",
          "from": "waiting",
          "to": "rejected",
          "trigger": {
            "type": "timer",
            "name": "deadline"
          },
          "label": "deadline passed",
          "duration_ns": 0,
          "actions": [
            {
              "op": "verdict",
              "outcome": "reject",
              "reason": "'no answer by the deadline ' + str(round(deadline_fs / 1e6, 6)) + ' ns'"
            }
          ]
        }
      ],
      "port_kinds": {
        "prover": [
          "quantum",
          "classical"
        ]
      }
    },
