      "name": "qpv_bb84_adv_teleport_receiver",
      "role": "adversary",
      "description": "Teleportation attack, adversary near the classical verifier: on theta, measures its EPR half 'e' in basis theta, sends (theta, m) to its partner, and corrects with the partner's Bell outcomes.",
      "ports": [
        "verifier",
        "partner"
      ],
      "params": {},
      "variables": {
        "th": 0,
        "m": 0
      },
      "initial": "intercept",
      "states": [
        {
          "id": "intercept",
          "kind": "initial",
          "label": "Intercept theta",
          "ui": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "measured",
